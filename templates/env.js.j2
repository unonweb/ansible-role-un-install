{% for key, value in un_install_env.items() %}
{% if value is boolean %}
{{ key }}={{ value | lower }}
{% elif value is none %}
{{ key }}=
{% elif value is sequence and value is not string and value is not mapping %}
{{ key }}="{{ value | join(',') }}"
{% else %}
{{ key }}="{{ value | string | replace('\\', '\\\\') | replace('"', '\\"') | replace('\n', '\\n') }}"
{% endif %}
{% endfor %}