[Desktop Entry]
Encoding={{ un_install_desktop.encoding }}
Type={{ un_install_desktop.type }}
Name={{ un_install_desktop.name }}
{% if un_install_desktop.comment is defined %}
Comment={{ un_install_desktop.comment }}
{% endif %}
Exec={{ un_install_desktop.exec }}
{% if un_install_desktop.path is defined %}
Path={{ un_install_desktop.path }}
{% endif %}
{% if un_install_desktop.icon is defined %}
Icon={{ un_install_desktop.icon }}
{% endif %}
{% if un_install_desktop.categories is defined %}
Categories={{ un_install_desktop.categories if un_install_desktop.categories is string else un_install_desktop.categories | join(';') ~ ';' }}
{% endif %}
Terminal={{ un_install_desktop.terminal | lower }}
{% if un_install_desktop.mime_type is defined %}
MimeType={{ un_install_desktop.mime_type if un_install_desktop.mime_type is string else un_install_desktop.mime_type | join(';') ~ ';' }}
{% endif %}
{% if un_install_desktop.startup_notify is defined %}
StartupNotify={{ un_install_desktop.startup_notify | lower }}
{% endif %}
{% if un_install_desktop.extra_entries is defined %}
{% for key, value in un_install_desktop.extra_entries.items() %}
{{ key }}={{ value }}
{% endfor %}
{% endif %}